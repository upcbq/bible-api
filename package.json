{
  "name": "quiz-bible-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json",
    "build:es": "esbuild src/index.ts --outfile=dist/index.js --bundle --loader:.ts=ts --platform=node --external:saslprep --external:swagger-ui-dist",
    "start": "nodemon ./dist/index.js",
    "dev": "tsx watch -r tsconfig-paths/register ./src/index.ts --dir .",
    "prod": "npm run build && npm run start",
    "clean": "rm -rf node_modules coverage dist .nyc_output",
    "lint": "eslint 'src/**/*.ts' --fix",
    "ingestData": "tsx -r tsconfig-paths/register src/scripts/ingestData.ts",
    "docker:up": "TAG=latest docker compose --env-file=./.env -f ./docker/docker-compose.yml up -d",
    "docker:down": "TAG=latest docker compose --env-file=./.env -f ./docker/docker-compose.yml down",
    "docker:build": "TAG=latest docker compose --env-file=./.env -f ./docker/docker-compose.yml build",
    "docker:push": "TAG=latest docker compose --env-file=./.env -f ./docker/docker-compose.yml push"
  },
  "keywords": [],
  "author": "Landon Bland",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^2.3.0",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "lodash": "^4.18.1",
    "mongoose": "^9.10.3",
    "morgan": "^1.12.1",
    "nodemon": "^3.1.14",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/lodash": "^4.14.202",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.9.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsconfig-paths": "^4.2.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}